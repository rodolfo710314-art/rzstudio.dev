# ══════════════ NÚCLEO (requeridas) ══════════════

# Anthropic API — https://console.anthropic.com/settings/keys
# Motor de: chat público, war room (agente ingeniero) y juez de hierro
ANTHROPIC_API_KEY=sk-ant-api03-...

# Cadena aleatoria para firmar cookies de sesión admin (mínimo 32 caracteres)
ADMIN_SECRET=cambia-esto-por-una-cadena-aleatoria-segura

# Contraseña del panel /admin
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-segura

# ══════════════ PRODUCCIÓN (Cloud Run) ══════════════
# ⚠️ Al actualizar variables por CLI usa SIEMPRE --update-env-vars (agrega/modifica).
#    --set-env-vars REEMPLAZA el conjunto completo y borra las demás (incidente 11/06/2026).

# URL pública del sitio — usada en correos y enlaces de activación
RZ_BASE_URL=https://rzstudio.dev

# Base de datos (Fase B): Firestore en producción, archivos JSON locales en dev.
# Cloud Run autentica con su service account — requiere rol roles/datastore.user:
#   gcloud projects add-iam-policy-binding rzstudio-bcd94 \
#     --member="serviceAccount:NUMERO-compute@developer.gserviceaccount.com" \
#     --role="roles/datastore.user"
RZ_STORAGE=firestore

# Binarios APK en Google Cloud Storage (sin esto: disco local, efímero en Cloud Run)
#   gcloud storage buckets create gs://rzstudio-apks --location=us-west1
#   (la service account necesita roles/storage.objectAdmin sobre el bucket)
RZ_GCS_BUCKET=rzstudio-apks

# (Solo si NO usas Firestore) directorio de datos en disco:
# RZ_DATA_DIR=/mnt/rzdata/data
# RZ_APK_DIR=/mnt/rzdata/apks

# ══════════════ INTEGRACIONES (activan funciones al configurarse) ══════════════

# Cron de mantenimiento (Cloud Scheduler → GET /api/cron/maintenance
# con header "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Email transaccional via Resend — avisos de expiración, seguimiento 48h y contacto
RESEND_API_KEY=
EMAIL_FROM=lab@rzstudio.dev

# Destino de los mensajes del formulario de contacto
CONTACT_EMAIL=rodolfog@rzstudio.dev

# GitHub API — merge/purga real de PRs ai-feature/* desde el war room
GITHUB_TOKEN=

# Fallback de IA: Gemini vía Vertex AI cuando Claude no está disponible.
# Autentica con la service account (igual que Firestore) — requiere:
#   gcloud services enable aiplatform.googleapis.com
#   rol roles/aiplatform.user a la service account de Cloud Run
GEMINI_MODEL=gemini-3.1-pro
GOOGLE_VERTEX_LOCATION=global
